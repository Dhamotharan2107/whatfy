#!/bin/bash
LOCK_FILE="/tmp/startup.lock"

if [ -f "$LOCK_FILE" ]; then
  echo "Startup already executed. Skipping..."
  exit 0
fi

touch "$LOCK_FILE"

sleep 20

# Install rclone


sudo apt-get install -y rclone -q

# Create mount folders
mkdir -p ~/b2/sever-3
mkdir -p ~/b2/m7testin

# Mount only if not mounted
mountpoint -q ~/b2/sever-3 || rclone mount b2:sever-3 ~/b2/sever-3 --daemon
mountpoint -q ~/b2/m7testin || rclone mount r2:m7testin ~/b2/m7testin --daemon

# Remove old Docker container
docker rm -f whatfy 2>/dev/null

# Restore Docker image
docker load -i ~/whatfy.tar

# Run Docker app
docker run -d \
--network host \
--name whatfy \
tertwer/whatfy

# Wait app startup
sleep 10

# Kill old tunnels safely
pkill -x cloudflared 2>/dev/null

# Start Cloudflare tunnel
nohup ~/cloudflared-linux-amd64 tunnel \
--config ~/.cloudflared/config.yml \
run whatfy > ~/tunnel.log 2>&1 &

