# MCP Server Configuration

# Server Settings
MCP_HOST=0.0.0.0
MCP_PORT=8001

# Rate Limiting
RATE_LIMIT_WINDOW=60
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_BURST=3

# Excel Upload Settings
MAX_EXCEL_SIZE=10485760
MAX_PHONES_PER_FILE=5000
MAX_BATCH_SIZE=1000

# WhatsApp Integration
GO_SERVER_URL=http://localhost:8080
WHATSAPP_API_KEY=your_api_key_here

# OAuth Settings
DEFAULT_GRANT_TYPE=client_credentials
DEFAULT_SCOPE=whatsapp_message
